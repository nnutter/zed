#!/usr/bin/env bash
#
# script/bundle-arch — build a local Arch Linux package (.pkg.tar.zst) of Zed
# from the current checkout using makepkg.
#
# The package replaces the distro `zed` (provides/conflicts) so the PKGBUILD
# installs the editor as /usr/bin/zed with its companion binary at
# /usr/lib/zed/zed-editor, matching the layout documented in
# docs/src/development/linux.md. The cargo invocation mirrors
# script/bundle-linux (same bundle config, linker, and release flags).
#
# Because the source is pinned to the current commit via a `git+file://`
# URL, the build is offline and reproducible, but it also means uncommitted
# changes are NOT included: the script refuses to run with a dirty tree.
#
# Usage:
#   script/bundle-arch [--install] [--clean] [--pkgname NAME] [--out DIR]
#
# Options:
#   --install       install the built package with `makepkg -i` (replaces
#                   the distro zed package after a pacman confirmation).
#   --clean         wipe the output directory before building.
#   --pkgname NAME  package name (default: zed-threads).
#   --out DIR       directory for the generated PKGBUILD and packages
#                   (default: <repo>/target/arch-pkg).
#   --print-only    write the PKGBUILD and .SRCINFO without building.
#
# Before running this on Omarchy/Arch, install the build dependencies with:
#   ./script/linux

set -euo pipefail

pkgname="zed-threads"
install=false
clean=false
print_only=false
out=""

usage() {
    sed -n '2,/^$/p' "$0" | sed 's/^# \{0,1\}//'
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        -h | --help)
            usage
            exit 0
            ;;
        --install)
            install=true
            shift
            ;;
        --clean)
            clean=true
            shift
            ;;
        --pkgname)
            pkgname="$2"
            shift 2
            ;;
        --out)
            out="$2"
            shift 2
            ;;
        --print-only)
            print_only=true
            shift
            ;;
        --)
            shift
            break
            ;;
        -*)
            echo "Unknown option: $1" >&2
            usage >&2
            exit 1
            ;;
        *)
            echo "Unexpected argument: $1" >&2
            usage >&2
            exit 1
            ;;
    esac
done

for tool in git makepkg; do
    if ! command -v "$tool" >/dev/null 2>&1; then
        echo "Required tool not found: $tool" >&2
        exit 1
    fi
done

if [[ "$(id -u)" -eq 0 ]]; then
    echo "makepkg refuses to run as root; run this as a regular user." >&2
    exit 1
fi

root="$(git rev-parse --show-toplevel)"
cd "$root"

if ! git diff --quiet || ! git diff --cached --quiet \
    || [[ -n "$(git ls-files --others --exclude-standard)" ]]; then
    echo "Refusing to build with a dirty working tree: the package source is" >&2
    echo "pinned to the current commit, so uncommitted changes would silently" >&2
    echo "not be included. Commit or stash them first." >&2
    exit 1
fi

# shellcheck disable=SC2155
branch="$(git branch --show-current)"
sha="$(git rev-parse HEAD)"
short="$(git rev-parse --short HEAD)"
count="$(git rev-list --count HEAD)"
version="$(script/get-crate-version zed)"
pkgver="${version}.r${count}.g${short}"

out="${out:-$root/target/arch-pkg}"
if "$clean"; then
    rm -rf "$out"
fi
mkdir -p "$out"

# Values are restricted to safe shapes (pkgname/sha/version come from git and
# Cargo metadata), so plain substitution below is safe.
sed -e "s|__PKGNAME__|$pkgname|g" \
    -e "s|__PKGVER__|$pkgver|g" \
    -e "s|__VERSION__|$version|g" \
    -e "s|__BRANCH__|$branch|g" \
    -e "s|__COMMIT__|$sha|g" \
    -e "s|__REPO_ROOT__|$root|g" >"$out/PKGBUILD" <<'PKGBUILD_EOF'
# Generated by script/bundle-arch — do not edit; rerun the script instead.
pkgname=__PKGNAME__
pkgver=__PKGVER__
pkgrel=1
pkgdesc="Zed editor, local fork build (branch __BRANCH__, commit __COMMIT__)"
arch=('x86_64' 'aarch64')
url="https://zed.dev"
license=('GPL-3.0-or-later')
provides=('zed')
conflicts=('zed')
depends=(
    alsa-lib fontconfig gcc-libs glibc glib2 hicolor-icon-theme
    libgit2 libva libxcb libxkbcommon-x11 openssl pipewire
    sqlite vulkan-icd-loader wayland xdg-desktop-portal zstd
)
makedepends=(git rust clang lld cmake jq)
source=("$pkgname::git+file://__REPO_ROOT__#commit=__COMMIT__")
sha256sums=('SKIP')

build() {
    cd "$pkgname"

    for tool in cargo rustc clang jq; do
        if ! command -v "$tool" >/dev/null 2>&1; then
            echo "Required build tool not found: $tool" >&2
            exit 1
        fi
    done

    # bundle-linux refuses RUSTFLAGS from makepkg.conf; the release flags
    # live in .cargo/bundle-config.toml instead.
    unset RUSTFLAGS CARGO_ENCODED_RUSTFLAGS

    export ZED_BUNDLE=true
    export RELEASE_VERSION="__VERSION__"
    export ZED_UPDATE_EXPLANATION="Managed by pacman ($pkgname); rebuild with script/bundle-arch to update."

    # Generate the licenses first, so they can be baked into the binaries.
    ./script/generate-licenses

    export CC="${CC:-$(command -v clang)}"
    lld=${LLD:-$("$CC" -print-prog-name=ld.lld)}
    if [[ "$lld" != /* || ! -x "$lld" ]]; then
        echo "Bundling requires an absolute executable linker path; set LLD (e.g. LLD=/usr/bin/ld.lld)." >&2
        exit 1
    fi

    # Same invocation as script/bundle-linux, minus --target (native build).
    # remote_server is intentionally not built here; this is a client-only
    # package. See script/bundle-linux for server artifacts.
    cargo --config .cargo/bundle-config.toml rustc --release \
        --package zed --bin zed -- \
        -C linker="$CC" -C llvm-args=-addrsig \
        -C link-arg=-fuse-ld=lld -C link-arg=--ld-path="$lld" \
        -C link-arg=-Wl,--icf=safe
    cargo --config .cargo/bundle-config.toml build --release --package cli
}

package() {
    cd "$pkgname"

    # The cli locates the editor at ../lib/zed/zed-editor relative to itself,
    # so /usr/bin/zed pairs with /usr/lib/zed/zed-editor.
    install -Dm755 target/release/cli "$pkgdir/usr/bin/zed"
    install -Dm755 target/release/zed "$pkgdir/usr/lib/zed/zed-editor"

    install -Dm644 crates/zed/resources/app-icon.png \
        "$pkgdir/usr/share/icons/hicolor/512x512/apps/zed.png"
    install -Dm644 crates/zed/resources/app-icon@2x.png \
        "$pkgdir/usr/share/icons/hicolor/1024x1024/apps/zed.png"

    APP_NAME="Zed" APP_ID="dev.zed.Zed" APP_CLI="zed" APP_ICON="zed" \
        APP_ARGS="%U" DO_STARTUP_NOTIFY="true" \
        envsubst <crates/zed/resources/zed.desktop.in \
        >"$pkgdir/usr/share/applications/dev.zed.Zed.desktop"
    chmod 755 "$pkgdir/usr/share/applications/dev.zed.Zed.desktop"

    install -Dm644 assets/licenses.md \
        "$pkgdir/usr/share/licenses/$pkgname/licenses.md"
}
PKGBUILD_EOF

(
    cd "$out"
    makepkg --printsrcinfo >.SRCINFO
)

if "$print_only"; then
    echo "PKGBUILD written to $out/PKGBUILD:"
    cat "$out/PKGBUILD"
    exit 0
fi

makepkg_args=(-f)
if command -v pacman >/dev/null 2>&1; then
    makepkg_args+=(-s)
else
    echo "pacman not found; building without resolving dependencies (-s skipped)."
    echo "Ensure the depends/makedepends from the PKGBUILD are installed."
fi
if "$install"; then
    makepkg_args+=(-i)
fi

(
    cd "$out"
    makepkg "${makepkg_args[@]}"
)

echo "Package built in $out:"
ls "$out"/*.pkg.tar.zst
